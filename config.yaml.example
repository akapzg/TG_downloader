api_hash: your_api_hash_here
api_id: your_api_id_here
chat:
- chat_id: telegram_chat_id
  last_read_message_id: 0
file_formats:
  audio:
  - all
  document:
  - all
  video:
  - all
file_path_prefix:
- chat_title
- media_datetime
media_types:
- audio
- photo
- video
- document
- voice
- video_note
# ── Web UI password (set via WEB_LOGIN_SECRET env var or here) ──
# web_login_secret: your_password
# ── Web UI server configuration ──────────────────────────────────
# web_host: "0.0.0.0"
# web_port: 5000
# ── Proxy configuration ──────────────────────────────────────────
# proxy:
#   enabled: false
#   hostname: "127.0.0.1"
#   port: 1080
# ── Max concurrent download tasks ────────────────────────────────
# max_download_task: 5
# ── Bot configuration ──────────────────────────────────────────
# bot_token: "1234567890:ABCdefGHIjklMNOpqrsTUVwxyz"
# allowed_user_ids:
#   - 123456789
# ── Cloud upload via rclone ────────────────────────────────────
# upload_drive:
#   enable_upload_file: false
#   upload_adapter: rclone
#   remote_dir: "gdrive:/telegram_downloads"
#   before_upload_file_zip: false
#   after_upload_file_delete: true
